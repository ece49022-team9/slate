+static void esp32_machine_init_slate(Esp32SocState *ss)
+{
+    Chardev *chr = qemu_chr_find("slate");
+    if (!chr) {
+        return;
+    }
+    BusState *vspi = qdev_get_child_bus(DEVICE(&ss->spi[3]), "spi");
+    DeviceState *board = qdev_new(TYPE_SLATE_BOARD);
+    qdev_prop_set_chr(board, "chardev", chr);
+    qdev_realize_and_unref(board, vspi, &error_fatal);
+    for (int pin = 0; pin < ESP32_GPIO_PINS; ++pin) {
+        qdev_connect_gpio_out_named(DEVICE(&ss->gpio), ESP32_GPIO_OUT, pin,
+                                    qdev_get_gpio_in_named(board, "pin", pin));
+    }
+}
