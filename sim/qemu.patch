 static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint64_t level = (s->in & ~s->enable) | (s->out & s->enable);
     uint64_t r = 0;
     switch (addr) {
     case A_GPIO_STRAP:
         r = s->strap_mode;
         break;
-
+    case A_GPIO_OUT:
+        r = (uint32_t) s->out;
+        break;
+    case A_GPIO_OUT1:
+        r = s->out >> 32;
+        break;
+    case A_GPIO_ENABLE:
+        r = (uint32_t) s->enable;
+        break;
+    case A_GPIO_ENABLE1:
+        r = s->enable >> 32;
+        break;
+    case A_GPIO_IN:
+        r = (uint32_t) level;
+        break;
+    case A_GPIO_IN1:
