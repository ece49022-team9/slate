diff --git a/hw/misc/slate_board.c b/hw/misc/slate_board.c
new file mode 100644
index 0000000..cbf02ec
--- /dev/null
+++ b/hw/misc/slate_board.c
@@ -0,0 +1,100 @@
+/*
+ * Slate breadboard bridge: reports GPIO output levels and SPI bytes to the
+ * Slate part models over a character device.
+ *
+ * Each message is: kind (1 byte), virtual time in ns (8 bytes, little endian),
+ * payload length (2 bytes, little endian), payload.
+ *   'G' payload: pin, level
+ *   'S' payload: bytes written on the SPI bus since the previous message
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/misc/slate_board.h"
+
+static void slate_board_send(SlateBoardState *s, uint8_t kind, int64_t ns,
+                             const uint8_t *payload, uint16_t len)
+{
+    uint8_t header[11];
+    header[0] = kind;
+    stq_le_p(header + 1, ns);
+    stw_le_p(header + 9, len);
+    if (qemu_chr_fe_write_all(&s->chr, header, sizeof(header)) != sizeof(header) ||
+        qemu_chr_fe_write_all(&s->chr, payload, len) != len) {
+        error_report("slate.board: lost connection to the part models");
+        exit(1);
+    }
+}
+
+static void slate_board_flush(SlateBoardState *s)
+{
+    if (s->spi_len) {
+        slate_board_send(s, 'S', s->spi_ns, s->spi, s->spi_len);
+        s->spi_len = 0;
+    }
+}
+
+static uint32_t slate_board_transfer(SSIPeripheral *dev, uint32_t value)
+{
+    SlateBoardState *s = SLATE_BOARD(dev);
+    if (s->spi_len == 0) {
+        s->spi_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    }
+    s->spi[s->spi_len++] = value;
+    if (s->spi_len == SLATE_BOARD_SPI_BUFFER) {
+        slate_board_flush(s);
+    }
+    return 0;
+}
+
+static void slate_board_pin(void *opaque, int pin, int level)
+{
+    SlateBoardState *s = SLATE_BOARD(opaque);
+    uint8_t payload[] = { pin, level != 0 };
+    slate_board_flush(s);
+    slate_board_send(s, 'G', qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), payload, 2);
+}
+
+static void slate_board_realize(SSIPeripheral *dev, Error **errp)
+{
+    SlateBoardState *s = SLATE_BOARD(dev);
+    if (!qemu_chr_fe_backend_connected(&s->chr)) {
+        error_setg(errp, "slate.board needs a chardev");
+        return;
+    }
+    qdev_init_gpio_in_named(DEVICE(dev), slate_board_pin, "pin", SLATE_BOARD_PINS);
+}
+
+static Property slate_board_properties[] = {
+    DEFINE_PROP_CHR("chardev", SlateBoardState, chr),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void slate_board_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    k->realize = slate_board_realize;
+    k->transfer = slate_board_transfer;
+    k->cs_polarity = SSI_CS_NONE;
+    device_class_set_props(dc, slate_board_properties);
+}
+
+static const TypeInfo slate_board_info = {
+    .name = TYPE_SLATE_BOARD,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(SlateBoardState),
+    .class_init = slate_board_class_init,
+};
+
+static void slate_board_register_types(void)
+{
+    type_register_static(&slate_board_info);
+}
+
+type_init(slate_board_register_types)
