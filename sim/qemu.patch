+static uint64_t esp32_gpio_apply(uint64_t current, hwaddr offset, uint64_t value)
+{
+    switch (offset) {
+    case 0x0:
+        return value;
+    case 0x4:
+        return current | value;
+    default:
+        return current & ~value;
+    }
+}
+
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint64_t before = s->out;
+    if (addr >= A_GPIO_OUT && addr <= A_GPIO_OUT_W1TC) {
+        uint64_t low = esp32_gpio_apply((uint32_t) s->out, addr - A_GPIO_OUT, value);
+        s->out = (s->out & ~0xffffffffULL) | (uint32_t) low;
+    } else if (addr >= A_GPIO_OUT1 && addr <= A_GPIO_OUT1_W1TC) {
+        uint64_t high = esp32_gpio_apply(s->out >> 32, addr - A_GPIO_OUT1, value);
+        s->out = (s->out & 0xffffffffULL) | (high << 32);
+    } else if (addr >= A_GPIO_ENABLE && addr <= A_GPIO_ENABLE_W1TC) {
+        uint64_t low = esp32_gpio_apply((uint32_t) s->enable, addr - A_GPIO_ENABLE, value);
+        s->enable = (s->enable & ~0xffffffffULL) | (uint32_t) low;
+    } else if (addr >= A_GPIO_ENABLE1 && addr <= A_GPIO_ENABLE1_W1TC) {
+        uint64_t high = esp32_gpio_apply(s->enable >> 32, addr - A_GPIO_ENABLE1, value);
+        s->enable = (s->enable & 0xffffffffULL) | (high << 32);
+    }
+    for (uint64_t changed = before ^ s->out; changed; changed &= changed - 1) {
+        int pin = ctz64(changed);
+        qemu_set_irq(s->pins[pin], (s->out >> pin) & 1);
+    }
 }
 
