+	}
+
+	/** The canvas's size in device pixels. */
+	setView(w: number, h: number) {
+		const c = this.canvas;
+		if (c.width !== w || c.height !== h) {
+			c.width = w;
+			c.height = h;
+		}
+		this.view = [w, h];
+	}
+
+	/** Copies a decoded frame (a stripe at row `y`) into the screen: where `rects` say
+	 * it changed, or all of it. */
+	frame(frame: VideoFrame, y: number, rects: Rect[] | null) {
+		const gl = this.gl;
+		if (!this.screenFb) return;
