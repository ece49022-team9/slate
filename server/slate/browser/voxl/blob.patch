+++ b/src/lossless.rs
@@ -0,0 +1,352 @@
+//! Lossless still frames (--lossless-still-ms). Blocks that changed and then stayed still
+//! are sent once as PNG beside the H.264 stream, so a still screen shows its true pixels:
+//! no 4:2:0 chroma, no quantization. Each video frame is preceded by the rectangles it
+//! changed (a damage message); the client copies a decoded frame only into those, so a
+//! lossless block stays on screen until its pixels change again.
+//!
+//! Ordering: a patch is taken from the capture buffer in the capture thread, encoded on a
+//! thread of its own, and sent only once every frame captured before it has been sent and
+//! none of its blocks changed since, so it never lands on top of newer pixels.
+
+use crate::hub::{Hub, Out};
+use bytes::Bytes;
+use parking_lot::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::sync::{mpsc, Arc};
+use std::time::{Duration, Instant};
+
+/// Server: a frame's damage. Type, flags (1 = the whole screen), frame id (u32), count
+/// (u16), then count rectangles of x, y, w, h (u16 each, pixels).
+pub const DAMAGE: u8 = 0x06;
+/// Server: a lossless patch. Type, reserved, x, y, w, h (u16 each, pixels), then a PNG.
+pub const PATCH: u8 = 0x05;
+const PATCH_HEADER: usize = 10;
+const BLOCK: usize = 16;
+
+/// A rectangle of 16-pixel blocks.
+#[derive(Clone, Copy, Debug)]
+pub struct Blocks {
+    pub x: usize,
+    pub y: usize,
+    pub w: usize,
+    pub h: usize,
+}
+
+/// Rectangles covering the set blocks of a block map: runs along each row, joined with
+/// the run below when they span the same columns.
+pub fn rects(map: &[u8], cols: usize) -> Vec<Blocks> {
+    let mut out: Vec<Blocks> = Vec::new();
+    // Rectangles that end on the row above, by their columns, to extend downward.
+    let mut open: Vec<usize> = Vec::new();
+    for (y, row) in map.chunks(cols).enumerate() {
+        let mut next_open = Vec::new();
+        let mut x = 0;
+        while x < row.len() {
+            if row[x] == 0 {
+                x += 1;
+                continue;
+            }
+            let x0 = x;
+            while x < row.len() && row[x] != 0 {
+                x += 1;
+            }
+            let w = x - x0;
+            match open
+                .iter()
+                .find(|&&i| out[i].x == x0 && out[i].w == w && out[i].y + out[i].h == y)
+            {
+                Some(&i) => {
+                    out[i].h += 1;
+                    next_open.push(i);
+                }
+                None => {
+                    out.push(Blocks { x: x0, y, w, h: 1 });
+                    next_open.push(out.len() - 1);
+                }
+            }
+        }
+        open = next_open;
+    }
+    out
+}
+
+/// What the capture, encode and patch threads share.
+pub struct Shared {
+    /// The capture sequence number of the latest frame, and of the frame each block last
+    /// changed in.
+    state: Mutex<(u32, Vec<u32>)>,
+    /// The sequence number of the last frame the encode thread sent (or found nothing to send in).
+    pub sent: AtomicU32,
+    pub cols: usize,
+    pub width: usize,
+    pub height: usize,
+}
+
+impl Shared {
+    /// Notes a captured frame and the blocks it changed (every block, without a map), and
+    /// returns its sequence number.
+    pub fn capture(&self, dirty: Option<&[u8]>) -> u32 {
+        let mut s = self.state.lock();
+        s.0 += 1;
+        let seq = s.0;
+        match dirty {
+            Some(d) => {
+                for (c, &x) in s.1.iter_mut().zip(d) {
+                    if x != 0 {
+                        *c = seq;
+                    }
+                }
+            }
+            None => s.1.fill(seq),
+        }
+        seq
+    }
+
+    /// A damage message for frame `frame`: the rectangles of `dirty`, or the whole screen.
+    pub fn damage(&self, frame: u32, dirty: Option<&[u8]>) -> Bytes {
+        let list = dirty.map(|d| rects(d, self.cols)).unwrap_or_default();
+        let mut m = Vec::with_capacity(8 + list.len() * 8);
+        m.push(DAMAGE);
+        m.push(dirty.is_none() as u8);
+        m.extend_from_slice(&frame.to_be_bytes());
+        m.extend_from_slice(&(list.len().min(u16::MAX as usize) as u16).to_be_bytes());
+        for r in list.iter().take(u16::MAX as usize) {
+            let (x, y, w, h) = self.pixels(r);
+            for v in [x, y, w, h] {
+                m.extend_from_slice(&(v as u16).to_be_bytes());
+            }
+        }
+        Bytes::from(m)
+    }
+
+    /// A block rectangle in pixels, cut to the screen.
+    fn pixels(&self, r: &Blocks) -> (usize, usize, usize, usize) {
+        let (x, y) = (r.x * BLOCK, r.y * BLOCK);
+        let w = (r.w * BLOCK).min(self.width - x);
+        let h = (r.h * BLOCK).min(self.height - y);
+        (x, y, w, h)
+    }
+}
+
+/// The capture thread's side: which blocks changed since their last patch, and when.
+pub struct Tracker {
+    pub shared: Arc<Shared>,
+    epoch: Instant,
+    changed_ms: Vec<u32>,
+    pending: Vec<bool>,
+    still_ms: u32,
+    /// A round of patches is being encoded or waits to be sent.
+    busy: Arc<AtomicBool>,
+    patch_tx: mpsc::Sender<Round>,
+    retry_rx: mpsc::Receiver<Blocks>,
+}
+
+/// One round of patches: the pixels of each rectangle (RGB) as of capture `seq`.
+struct Round {
+    seq: u32,
+    parts: Vec<(Blocks, Vec<u8>)>,
+}
+
+impl Tracker {
+    /// Starts the patch thread for a `width` x `height` screen.
+    pub fn new(width: usize, height: usize, still_ms: u32, hub: Arc<Hub>) -> Self {
+        let cols = width.div_ceil(BLOCK);
+        let blocks = cols * height.div_ceil(BLOCK);
+        let shared = Arc::new(Shared {
+            state: Mutex::new((0, vec![0; blocks])),
+            sent: AtomicU32::new(0),
+            cols,
+            width,
+            height,
+        });
+        let busy = Arc::new(AtomicBool::new(false));
+        let (patch_tx, patch_rx) = mpsc::channel();
+        let (retry_tx, retry_rx) = mpsc::channel();
+        let (s, b) = (shared.clone(), busy.clone());
+        std::thread::Builder::new()
+            .name("lossless".into())
+            .spawn(move || patch_loop(patch_rx, s, hub, retry_tx, b))
+            .unwrap();
+        Tracker {
+            shared,
+            epoch: Instant::now(),
+            changed_ms: vec![0; blocks],
+            pending: vec![true; blocks],
+            still_ms,
+            busy,
+            patch_tx,
+            retry_rx,
+        }
+    }
+
+    fn now(&self) -> u32 {
+        self.epoch.elapsed().as_millis() as u32
+    }
+
+    /// Blocks a captured frame changed (every block, without a map) wait for a patch.
+    pub fn mark(&mut self, dirty: Option<&[u8]>) {
+        let now = self.now();
+        for i in 0..self.pending.len() {
+            if dirty.is_none_or(|d| d[i] != 0) {
+                self.pending[i] = true;
+                self.changed_ms[i] = now;
+            }
+        }
+    }
+
+    /// Milliseconds until the next waiting block has been still long enough, if any waits.
+    pub fn next_due_ms(&self) -> Option<u32> {
+        // A round in flight wakes the capture thread as it ends.
+        if self.busy.load(Ordering::Acquire) {
+            return None;
+        }
+        let now = self.now();
+        self.pending
+            .iter()
+            .zip(&self.changed_ms)
+            .filter(|(&p, _)| p)
+            .map(|(_, &c)| (c + self.still_ms).saturating_sub(now))
+            .min()
+    }
+
+    /// Sends a round of patches for the blocks that have been still long enough, taking
+    /// their pixels from the capture buffer `px` (BGRX, `stride` bytes a row).
+    pub fn tick(&mut self, px: &[u8], stride: usize) {
+        while let Ok(r) = self.retry_rx.try_recv() {
+            let now = self.now();
+            for y in r.y..r.y + r.h {
+                for x in r.x..r.x + r.w {
+                    let i = y * self.shared.cols + x;
+                    if !self.pending[i] {
+                        self.pending[i] = true;
+                        self.changed_ms[i] = now;
+                    }
+                }
+            }
+        }
+        if self.busy.load(Ordering::Acquire) {
+            return;
+        }
+        let now = self.now();
+        let mut due = vec![0u8; self.pending.len()];
+        let mut any = false;
+        for i in 0..due.len() {
+            if self.pending[i] && now.saturating_sub(self.changed_ms[i]) >= self.still_ms {
+                due[i] = 1;
+                self.pending[i] = false;
+                any = true;
+            }
+        }
+        if !any {
+            return;
+        }
+        let seq = self.shared.state.lock().0;
+        let parts = rects(&due, self.shared.cols)
+            .into_iter()
+            .map(|r| {
+                let (x, y, w, h) = self.shared.pixels(&r);
+                let mut rgb = Vec::with_capacity(w * h * 3);
+                for row in y..y + h {
+                    let line = &px[row * stride + x * 4..row * stride + (x + w) * 4];
+                    for p in line.chunks_exact(4) {
+                        rgb.extend_from_slice(&[p[2], p[1], p[0]]);
+                    }
+                }
+                (r, rgb)
+            })
+            .collect();
+        self.busy.store(true, Ordering::Release);
+        if self.patch_tx.send(Round { seq, parts }).is_err() {
+            self.busy.store(false, Ordering::Release);
+        }
+    }
+}
+
+fn patch_loop(
+    rx: mpsc::Receiver<Round>,
+    shared: Arc<Shared>,
+    hub: Arc<Hub>,
+    retry: mpsc::Sender<Blocks>,
+    busy: Arc<AtomicBool>,
+) {
+    while let Ok(round) = rx.recv() {
+        let msgs: Vec<(Blocks, Option<Bytes>)> = round
+            .parts
+            .into_iter()
+            .map(|(r, rgb)| {
+                let (x, y, w, h) = shared.pixels(&r);
+                (r, encode(x, y, w, h, &rgb))
+            })
+            .collect();
+        // Every frame captured before these pixels goes out first.
+        let deadline = Instant::now() + Duration::from_secs(1);
+        while shared.sent.load(Ordering::Acquire).wrapping_sub(round.seq) > u32::MAX / 2
+            && Instant::now() < deadline
+        {
+            std::thread::sleep(Duration::from_millis(2));
+        }
+        let caught_up = shared.sent.load(Ordering::Acquire).wrapping_sub(round.seq) <= u32::MAX / 2;
+        {
+            // Held while sending, so no frame is marked between the check and the send.
+            let state = shared.state.lock();
+            let clients: Vec<_> = hub
+                .video_clients()
+                .into_iter()
+                .filter(|c| c.started.load(Ordering::Relaxed))
+                .collect();
+            for (r, msg) in msgs {
+                let unchanged = (r.y..r.y + r.h).all(|y| {
+                    (r.x..r.x + r.w).all(|x| state.1[y * shared.cols + x] <= round.seq)
+                });
+                match msg {
+                    Some(m) if caught_up && unchanged => {
+                        hub.stats.patch_bytes.fetch_add(m.len() as u64, Ordering::Relaxed);
+                        for c in &clients {
+                            c.send(Out::Bin(m.clone()));
+                        }
+                    }
+                    _ => {
+                        let _ = retry.send(r);
+                    }
+                }
+            }
+            hub.stats.patches.fetch_add(1, Ordering::Relaxed);
+        }
+        busy.store(false, Ordering::Release);
+        hub.wake();
+    }
+}
+
+/// A patch message: the rectangle's pixels as an RGB PNG.
+fn encode(x: usize, y: usize, w: usize, h: usize, rgb: &[u8]) -> Option<Bytes> {
+    let mut out = vec![0u8; PATCH_HEADER];
+    out[0] = PATCH;
+    for (i, v) in [x, y, w, h].into_iter().enumerate() {
+        out[2 + i * 2..4 + i * 2].copy_from_slice(&(v as u16).to_be_bytes());
+    }
+    let mut enc = png::Encoder::new(&mut out, w as u32, h as u32);
+    enc.set_color(png::ColorType::Rgb);
+    enc.set_depth(png::BitDepth::Eight);
+    enc.set_compression(png::Compression::Fast);
+    let mut wr = enc.write_header().ok()?;
+    wr.write_image_data(rgb).ok()?;
+    wr.finish().ok()?;
+    Some(Bytes::from(out))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rects_join_rows_of_the_same_span() {
+        let map = [
+            0, 1, 1, 0, //
+            0, 1, 1, 0, //
+            1, 0, 0, 1, //
+        ];
+        let r = rects(&map, 4);
+        let spans: Vec<_> = r.iter().map(|b| (b.x, b.y, b.w, b.h)).collect();
+        assert_eq!(spans, vec![(1, 0, 2, 2), (0, 2, 1, 1), (3, 2, 1, 1)]);
+    }
+}
