+// The screen as the worker draws it with WebGL2: a texture of the desktop at its own
+// size, which decoded frames are copied into where they changed and lossless patches
+// are written into, drawn onto the canvas at the view's device pixels: pixel for pixel
+// at whole multiples, else through a separable Lanczos-3 filter, which keeps text edges
+// that the browser's bilinear scaling of a <video> or canvas would blur.
+
+export interface Rect {
+	x: number;
+	y: number;
+	w: number;
+	h: number;
