+
+const QUAD = `#version 300 es
+in vec2 p;
+void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
+
+// Frame rows and patch rows go into the texture top row first, as the desktop's: the
+// texture's row y is the desktop's row y, and a pass into it writes row y at
+// gl_FragCoord.y = y + 0.5. Only the canvas, whose row 0 is its bottom, is flipped.
+const COPY = `#version 300 es
+precision highp float;
+uniform highp sampler2D src;
+uniform ivec2 at;
+out vec4 color;
+void main() { color = texelFetch(src, ivec2(gl_FragCoord.xy) - at, 0); }`;
+
+const WHOLE = `#version 300 es
+precision highp float;
+uniform highp sampler2D src;
+uniform int k;
+uniform int rows;
+out vec4 color;
+void main() {
+	ivec2 o = ivec2(gl_FragCoord.xy);
+	color = texelFetch(src, ivec2(o.x / k, (rows - 1 - o.y) / k), 0);
+}`;
