+// One axis of Lanczos-3: an output pixel at o reads the source around (o + 0.5) / scale
+// - 0.5, its kernel widened by 1 / scale when shrinking so every source pixel counts.
+const LANCZOS = `#version 300 es
+precision highp float;
+uniform highp sampler2D src;
+uniform float scale;
+uniform int vertical;
+uniform int rows;
+uniform int last;
+out vec4 color;
+float lanczos(float x) {
+	x = abs(x);
+	if (x < 1e-5) return 1.0;
+	if (x >= 3.0) return 0.0;
+	float p = 3.14159265 * x;
+	return 3.0 * sin(p) * sin(p / 3.0) / (p * p);
