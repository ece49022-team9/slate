+	setSource(w: number, h: number) {
+		const gl = this.gl;
+		if (this.src[0] === w && this.src[1] === h) return;
+		if (this.screen) gl.deleteTexture(this.screen);
+		if (this.screenFb) gl.deleteFramebuffer(this.screenFb);
+		[this.screen, this.screenFb] = this.target(w, h, false);
+		gl.bindFramebuffer(gl.FRAMEBUFFER, this.screenFb);
+		gl.clearColor(0, 0, 0, 1);
+		gl.clear(gl.COLOR_BUFFER_BIT);
+		gl.bindFramebuffer(gl.FRAMEBUFFER, null);
